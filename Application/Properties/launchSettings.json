{
  "profiles": {
    "todo": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "KeyVaultUri": "https://{VaultName}.vault.azure.net/"
      },
      "applicationUrl": "https://localhost:63709;http://localhost:8080"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "publishAllPorts": false,
      "httpPort": 8080,
      "useSSL": false,
      "environmentVariables": {
        "KeyVaultUri": "https://{VaultName}.vault.azure.net/"
      }
    }
  }
}